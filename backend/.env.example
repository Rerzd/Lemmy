# Copy to backend/.env and adjust. Every value has a working dev default,
# so this file is optional for local runs.

# Local SQLite file (relative to backend/). For Postgres you'd use something like
# postgresql+psycopg://user:password@localhost:5432/lemmy (and install a driver).
DATABASE_URL=sqlite:///./data/lemmy.db

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# External data: the TRM (datos.gov.co) and exchange rates (open.er-api.com), both free
# and keyless. "off" makes the API skip every outgoing request; the dashboard card and
# the currency converter then say "External data is off".
LEMMY_EXTERNAL_DATA=on
